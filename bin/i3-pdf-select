#! /bin/bash

docroot=${HOME}/Documents/
rofibin=rofi

pdfname=$(find "${docroot}" -name "*.pdf" \
     | sed -e "s,${docroot},," \
     | ${rofibin} -p "filename: " --only-match -dmenu -i -theme arthur)

fullname="${docroot}${pdfname}"

if [ -n "${pdfname}" ] && [ -e "${fullname}" ]
then
        exec papers "${fullname}"
fi
