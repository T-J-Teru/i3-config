#
# i3-exit -- session actions (lock / logout / suspend / hibernate / reboot /
# shutdown) for the i3 "System" mode ($mod+Shift+e). A lighter, keyboard-driven
# alternative to the rofi power menu on $mod+Escape (i3-power-menu).
#
# The destructive actions ask for confirmation via a zenity dialog first; lock
# uses xscreensaver, and the power actions go through systemd-logind (no sudo).
# Called from the i3 config's `mode "$mode_system"` block. See "Power menu /
# System mode" in i3-setup.md.

# Move the mouse pointer to the centre of the laptop's built-in panel (eDP*/LVDS*),
# falling back to the xrandr primary, then the first connected output. No-op if
# xdotool, xrandr, or a usable output isn't available.
warp_pointer_to_laptop() {
    command -v xdotool >/dev/null 2>&1 || return 0
    command -v xrandr  >/dev/null 2>&1 || return 0

    local geom rest w h x y
    # Prefer the internal laptop panel by name.
    geom=$(xrandr --query 2>/dev/null \
             | awk '/^(eDP|LVDS)[^ ]* connected/ {for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {print $i; exit}}')
    # Fall back to the primary output, then any connected output with a geometry.
    [ -n "$geom" ] || geom=$(xrandr --query 2>/dev/null | awk '/ connected primary / {print $4; exit}')
    [ -n "$geom" ] || geom=$(xrandr --query 2>/dev/null \
             | awk '/ connected/ {for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {print $i; exit}}')
    [ -n "$geom" ] || return 0

    # geom is WxH+X+Y -- warp to its centre.
    w=${geom%%x*}; rest=${geom#*x}
    h=${rest%%+*}; rest=${rest#*+}
    x=${rest%%+*}; y=${rest#*+}
    xdotool mousemove $(( x + w / 2 )) $(( y + h / 2 ))
}

# On-demand lock (Mod+Shift+x, System-mode lock). Warp the pointer to the laptop
# panel first so the unlock dialog lands there (see warp_pointer_to_laptop), then
# lock immediately.
lock() {
    warp_pointer_to_laptop
    xscreensaver-command -lock
}

# Blank + lock in preparation for system sleep (suspend/hibernate). Use -suspend
# rather than -lock: it's xscreensaver's purpose-built option for the sleep path,
# blanking and locking immediately (ignoring the lock-timeout grace) so the screen
# comes back properly blanked *and* locked on resume. Warp first, same as lock().
lock_for_sleep() {
    warp_pointer_to_laptop
    xscreensaver-command -suspend
}

logout() {
    i3-msg exit
}

# confirm ACTION -- pop a yes/no dialog; return 0 (proceed) only if confirmed.
# The labels are deliberately swapped (Cancel = "Yes", OK = "No") so the safe
# option ("No") is the default/highlighted button.
confirm() {
    zenity --question \
           --title="Confirmation required" \
           --text="Really $1?" \
           --cancel-label="Yes" \
           --ok-label="No"
    if [ $? = 1 ]; then
        return 0
    else
        return 1
    fi
}

case "$1" in
    lock)
        lock
        ;;
    logout)
        confirm logout && logout
        ;;
    suspend)
        confirm suspend && lock_for_sleep && systemctl suspend
        ;;
    hibernate)
        confirm hibernate && lock_for_sleep && systemctl hibernate
        ;;
    reboot)
        confirm reboot && systemctl reboot
        ;;
    shutdown)
        confirm shutdown && systemctl poweroff
        ;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
        ;;
esac

exit 0
