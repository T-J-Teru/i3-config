#
# i3-power-menu -- a rofi power menu for i3.
#
# Presents Lock / Logout / Suspend / Reboot / Shutdown and hands the chosen action
# to i3-exit, so the destructive ones get the same zenity confirmation dialog as the
# $mod+Shift+e "System mode" path. Actions go through systemd-logind (via polkit),
# so the active local session needs no sudo/password. Launched from the polybar
# power glyph (custom/text click-left) and bound to $mod+Escape in the i3 config.
#
# Icons are Font Awesome 6 Free (Solid) glyphs, generated with printf '\uXXXX' so the
# source stays ASCII while the exact codepoints reach rofi. pango falls back to the FA
# font per-glyph, so they render even though the rofi theme's font is not FA.

set -euo pipefail

# Glyphs: lock, sign-out, moon, rotate, power-off (Font Awesome 6 Free Solid).
lock=$(printf '')
logout=$(printf '')
suspend=$(printf '')
reboot=$(printf '')
shutdown=$(printf '')

options="$lock  Lock
$logout  Logout
$suspend  Suspend
$reboot  Reboot
$shutdown  Shutdown"

chosen="$(printf '%s\n' "$options" | rofi -dmenu -i -p 'Power' -theme arthur)"

# Match on the trailing label (the leading glyph varies). Delegate to i3-exit, which
# runs the actual action and confirms the destructive ones via zenity.
case "$chosen" in
  *Lock)     i3-exit lock ;;
  *Logout)   i3-exit logout ;;
  *Suspend)  i3-exit suspend ;;
  *Reboot)   i3-exit reboot ;;
  *Shutdown) i3-exit shutdown ;;
  *)         exit 0 ;;   # dismissed (Escape / empty)
esac
