# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:monospace 8

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex-autostart --autostart --environment i3

# Reapply the saved monitor layout for the currently-connected outputs (autorandr).
# Profiles are created graphically with arandr, then `autorandr --save <name>`.
# exec_always runs this on every i3 start/restart; autorandr also has its own udev
# hook for dock/undock. Profiles live in ~/.config/autorandr/ and are machine-
# specific (keyed to monitor EDIDs), so they are NOT version-controlled -- recreate
# them per machine. See "Monitor layout" in i3-setup.md.
exec_always --no-startup-id autorandr --change

# Compositor: picom provides translucency, soft drop shadows, frosted-glass blur
# and rounded corners (most visibly the deadd notification cards). picom has no
# --replace, so kill any running instance first to avoid stacking a second one on
# i3 restart. Config at ~/.config/picom/picom.conf. See "Compositor (picom)" in
# i3-setup.md.
exec_always --no-startup-id "pkill -x picom; sleep 0.5; exec picom --config $HOME/.config/picom/picom.conf"

# Notification daemon: deadd (Linux Notification Center). Owns the D-Bus
# org.freedesktop.Notifications name; shows notification pop-ups and a slide-out
# notification center. Built from source (not in Fedora's repos) and installed to
# ~/bin -- see "Notifications (deadd)" in i3-setup.md. Guarded like picom so an i3
# restart doesn't leave two daemons fighting over the D-Bus name (the process name
# truncates to 15 chars, hence `pkill -x deadd-notificat`).
# GTK_THEME=Adwaita:dark: deadd doesn't honour GNOME's prefer-dark portal setting,
# so under the plain (light) Adwaita theme it renders symbolic notification icons
# (the volume/brightness OSD sun/speaker) in a muted dark grey. Forcing the dark
# theme flips those to bright near-white; full-colour app icons are unaffected.
exec_always --no-startup-id "pkill -x deadd-notificat; sleep 0.5; exec env GTK_THEME=Adwaita:dark deadd-notification-center"

# Desktop wallpaper: a random image per monitor from ~/Pictures/Wallpapers, via
# feh (see "Desktop wallpaper (feh)" in i3-setup.md). exec_always re-rolls it on
# each i3 start/restart; the autorandr postswitch hook also repaints it on
# dock/undock so each monitor gets a correctly-sized image for the new layout.
exec_always --no-startup-id i3-wallpaper

# nm-applet and pactl (below) are a popular choice. Modify as you see fit.

# Screen saver + locking via xscreensaver (chosen over i3lock; see i3-setup.md).
# xscreensaver runs as a background daemon that provides the idle screensaver and
# idle-timeout locking. Adjust its behaviour with `xscreensaver-settings` (writes
# ~/.xscreensaver). The daemon also starts xscreensaver-systemd, which locks the
# screen before suspend/hibernate -- so no xss-lock is needed.
exec --no-startup-id xscreensaver -no-splash
# Lock the screen on demand:
bindsym $mod+Shift+x exec --no-startup-id xscreensaver-command -lock

# Power menu (rofi): Lock / Logout / Suspend / Reboot / Shutdown. Same script the
# polybar power glyph runs. Actions go via systemd-logind, no sudo. See i3-setup.md.
bindsym $mod+Escape exec --no-startup-id i3-power-menu

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet

# Volume: i3-osd adjusts the volume AND shows a deadd on-screen display (a progress
# bar that updates in place on repeated presses). See "Volume / brightness OSD" in
# i3-setup.md. (polybar's pulseaudio module updates itself, so no i3status refresh.)
bindsym XF86AudioRaiseVolume exec --no-startup-id i3-osd volume-up
bindsym XF86AudioLowerVolume exec --no-startup-id i3-osd volume-down
bindsym XF86AudioMute exec --no-startup-id i3-osd volume-mute
# Hold Shift for fine (1%) volume steps instead of the default 5%.
bindsym Shift+XF86AudioRaiseVolume exec --no-startup-id i3-osd volume-up 1
bindsym Shift+XF86AudioLowerVolume exec --no-startup-id i3-osd volume-down 1
# Mic mute has no OSD (no meaningful level to show); toggle it directly.
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Display backlight brightness via brightnessctl (works through systemd-logind, no root).
# i3-osd changes the brightness AND shows the same deadd OSD bar as volume. See
# "Display brightness" / "Volume / brightness OSD" in i3-setup.md.
bindsym XF86MonBrightnessUp exec --no-startup-id i3-osd brightness-up
bindsym XF86MonBrightnessDown exec --no-startup-id i3-osd brightness-down
# Hold Shift for fine (1%) brightness steps instead of the default 5%.
bindsym Shift+XF86MonBrightnessUp exec --no-startup-id i3-osd brightness-up 1
bindsym Shift+XF86MonBrightnessDown exec --no-startup-id i3-osd brightness-down 1

# Focus only follows keyboard/clicks, not the pointer: moving the mouse over an
# unfocused window (or the mouse ending up under a new window) won't steal focus.
focus_follows_mouse no

# Don't resize windows by dragging their border with plain left-click -- avoids
# accidental resizes when clicking near an edge. ($mod+button1 / button3 still
# resize; --exclude-titlebar keeps the title bar clickable as normal.)
bindsym --border --exclude-titlebar button1 nop

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# start a terminal
# Ptyxis is Fedora's default GNOME terminal (installed). i3-sensible-terminal would
# otherwise fall back to plain urxvt, so bind Ptyxis explicitly. See i3-setup.md.
# --new-window is required: Ptyxis is single-instance, so a bare `ptyxis` just raises
# the existing window instead of opening a new one. --new-window spawns a fresh window.
set $term ptyxis --new-window
bindsym $mod+Return exec --no-startup-id $term

# kill focused window
bindsym $mod+Shift+q kill

# Application launcher: rofi in drun mode (replaces the default dmenu). See i3-setup.md.
# NB: the whole command is wrapped in ONE double-quoted string because i3 treats a comma
# as a command separator -- the commas in -drun-match-fields must be protected. The inner
# single quotes around 'Start: ' are for sh (they preserve the trailing space in the prompt).
bindsym $mod+d exec --no-startup-id "rofi -modi drun -show drun -display-drun 'Start: ' -drun-match-fields name,generic,keywords -show-icons -theme arthur"

# Switch between windows on the current workspace (rofi windowcd modi).
bindsym $mod+Shift+Return exec --no-startup-id rofi -modi windowcd -show windowcd -show-icons -theme arthur

# --- Custom workspace modi ------------------------------------------------------------
# These call helper scripts in ~/bin (already on PATH). See "rofi" section of i3-setup.md.

# Move focused container to a chosen workspace (i3-move-container.sh: bash, no deps).
bindsym $mod+Shift+equal exec --no-startup-id rofi -show-icons -theme arthur -modi "Move container to workspace:i3-move-container.sh" -show 'Move container to workspace'

# Move current workspace to a chosen output (i3-move-workspace.py: needs python3-i3ipc).
bindsym $mod+Shift+minus exec --no-startup-id rofi -show-icons -theme arthur -modi "Move workspace to output:i3-move-workspace.py" -show 'Move workspace to output'

# Switch to a workspace (i3-switch-workspace.sh: bash, no deps).
bindsym $mod+equal exec --no-startup-id rofi -show-icons -theme arthur -modi "Workspaces:i3-switch-workspace.sh" -show Workspaces

# Rename the current workspace (i3-rename-workspace: Perl; uses rofi theme arthur-entry).
# Modernized to core Getopt::Long + Pod::Usage (custom GiveHelp module retired).
# Needs perl modules: perl-indirect, perl-JSON-Parse, perl-Carp-Assert. See i3-setup.md.
bindsym $mod+Shift+question exec --no-startup-id i3-rename-workspace
# -------------------------------------------------------------------------------------

# --- Other helper-script bindings -----------------------------------------------------
# Cycle focus through active outputs/monitors (i3-toggle-selected-output.py: python3-i3ipc).
bindsym $mod+Tab exec --no-startup-id i3-toggle-selected-output.py

# Fuzzy-find a PDF under ~/Documents and open it (i3-pdf-select: rofi + papers).
bindsym $mod+Shift+p exec --no-startup-id i3-pdf-select
# -------------------------------------------------------------------------------------

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# --- Scratchpad ---------------------------------------------------------------------
# A calculator always a keystroke away: a small floating urxvt running qalc, kept in
# i3's scratchpad. `exec` (not exec_always) spawns it once at login, so an in-place
# restart doesn't stack duplicates; the `while` loop respawns qalc if you quit it, so
# the window stays available. urxvt is used (not Ptyxis) because it can set a matchable
# WM_CLASS instance and run a command. See "Scratchpad (qalc calculator)" in i3-setup.md.
exec --no-startup-id urxvt -name calc-scratch -title "Calculator (qalc)" -fn "xft:monospace:size=12" -fg "#e0e0e0" -bg "#1c1c1c" -b 10 -e sh -c 'while true; do qalc --set "autocalc on"; done'
# First-map rules, matched on the WM_CLASS instance (urxvt -name), not the title: float
# it, size/centre it, and stash it so it starts hidden until summoned.
for_window [instance="calc-scratch"] floating enable, resize set 760 480, move position center, move scratchpad
# Toggle just the calculator (show if hidden / hide if showing).
bindsym $mod+c [instance="calc-scratch"] scratchpad show

# Generic scratchpad: stash the focused window, and show/cycle the stashed windows.
bindsym $mod+Shift+grave move scratchpad
bindsym $mod+grave scratchpad show
# ------------------------------------------------------------------------------------

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Pin all ten numbered workspaces to the primary output so they always live on
# the laptop panel (eDP-1 is the primary, set by autorandr/xrandr). The special
# `primary` keyword keeps this machine-independent -- no hardcoded output name.
# External monitors get other workspaces (e.g. via $mod+Shift+minus).
workspace $ws1 output primary
workspace $ws2 output primary
workspace $ws3 output primary
workspace $ws4 output primary
workspace $ws5 output primary
workspace $ws6 output primary
workspace $ws7 output primary
workspace $ws8 output primary
workspace $ws9 output primary
workspace $ws10 output primary

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Status bar: polybar (replaces the built-in i3bar/i3status). launch.sh starts one
# bar per connected monitor. See "Status bar (polybar)" in i3-setup.md.
# (The old i3bar block is kept below, commented, as a quick fallback.)
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

